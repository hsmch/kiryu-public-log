---
import Layout from '../layouts/Layout.astro';
import CategoryBlock from '../components/CategoryBlock.astro';
import {
  getAllSessions,
  getSessionSummary,
  getSplitBillCountForSession,
  getCouncilMembers,
  getPopulation,
  getBudget,
  getFeaturedAnnouncements,
  getUpdates,
} from '../lib/data';

export const prerender = true;

// 決める: 最新の定例会・臨時会
const sessions = getAllSessions();
const latest = sessions[0] ?? null;
const latestSummary = latest ? getSessionSummary(latest.slug) : null;
const latestBillCount = latestSummary?.totalBills ?? latest?.data.bills.length ?? 0;
const latestSplitCount = latestSummary?.splitCount ?? (latest ? getSplitBillCountForSession(latest.slug) : 0);

// お金
const population = getPopulation();
const budget = getBudget();
const budgetOku = budget ? Math.round(budget.generalAccount.total / 100_000_000) : null;
const perCapitaMan = population && budget
  ? Math.round(budget.generalAccount.total / population.current.population / 10000)
  : null;

// 人
const council = getCouncilMembers();
const totalMembers = council.officers.length + council.members.length;
const factionCount = new Set(council.members.map((m) => m.faction).filter(Boolean)).size;

// 最近の動き
const featuredAnnouncements = getFeaturedAnnouncements();
const recentUpdates = getUpdates()?.entries.slice(0, 5) ?? [];
const hasRecent = featuredAnnouncements.length > 0 || recentUpdates.length > 0;
---

<Layout path="/">
  <section class="mx-auto max-w-4xl px-4 py-10 sm:py-14">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Kiryu Public Log
      </h1>
      <p class="mt-4 text-lg text-gray-600 sm:text-xl">
        桐生市の運営を、公開情報で見る
      </p>
      <p class="mt-2 text-sm text-gray-500">
        はじめての方は
        <a href="/guide" class="text-blue-600 underline hover:text-blue-800">議会の仕組みガイド</a>
        へ
      </p>
    </div>

    <!-- 市の運営を要素で切った5分類（対等に並列） -->
    <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      <CategoryBlock id="sessions" title="決める" description="議会で何が決まったか" href="/sessions" linkLabel="議案・採決を見る">
        {latest && <p class="font-medium text-gray-900">{latest.data.session}</p>}
        {latest && <p class="text-gray-600">議案 {latestBillCount} 件・賛否分裂 {latestSplitCount} 件</p>}
      </CategoryBlock>

      <CategoryBlock id="finance" title="お金" description="予算・財政と人口" href="/finance" linkLabel="予算・財政を見る">
        {budgetOku && <p class="font-medium text-gray-900">一般会計 約{budgetOku.toLocaleString()}億円</p>}
        {perCapitaMan && <p class="text-gray-600">市民1人あたり 年約{perCapitaMan}万円</p>}
      </CategoryBlock>

      <CategoryBlock id="operations" title="実行" description="決めたことをどう実行しているか" href="/operations" linkLabel="入口を見る">
        <p class="font-medium text-gray-900">入札・契約、監査、計画</p>
        <p class="text-gray-600">公式ページへの入口を整理</p>
      </CategoryBlock>

      <CategoryBlock id="council" title="人" description="誰が担っているか" href="/council" linkLabel="議員一覧を見る">
        <p class="font-medium text-gray-900">議員 {totalMembers} 名・会派 {factionCount}</p>
        <p class="text-gray-600">議員ごとの投票行動と質問</p>
      </CategoryBlock>

      <CategoryBlock id="participate" title="関わる" description="市民が関わる方法" href="/participate" linkLabel="関わり方を見る">
        <p class="font-medium text-gray-900">傍聴・パブコメ・請願</p>
        <p class="text-gray-600">情報公開請求のしかた</p>
      </CategoryBlock>
    </div>

    <!-- 最近の動き -->
    {hasRecent && (
      <div class="mt-12">
        <h2 class="text-xl font-semibold text-gray-800">最近の動き</h2>
        <ul class="mt-3 space-y-2">
          {featuredAnnouncements.map((a) => (
            <li>
              <a href={(a.url && a.url.trim()) || '/updates'} class="block rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 card-interactive hover:border-blue-300">
                <div class="flex items-start gap-3">
                  <span class="shrink-0 text-sm text-gray-400">{a.date}</span>
                  <span class="shrink-0 rounded bg-blue-100 px-1.5 py-0.5 text-xs font-medium text-blue-800">お知らせ</span>
                  <span class="text-sm text-gray-900">{a.title}</span>
                </div>
              </a>
            </li>
          ))}
          {recentUpdates.map((entry) => (
            <li>
              <a href={entry.url} target="_blank" rel="noopener noreferrer" class="block rounded-lg border border-gray-200 bg-white px-4 py-3 card-interactive hover:border-blue-300">
                <div class="flex items-start gap-3">
                  <span class="shrink-0 text-sm text-gray-400">{entry.date}</span>
                  <span class={`shrink-0 rounded px-1.5 py-0.5 text-xs font-medium ${entry.label === '新規' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'}`}>
                    {entry.label}
                  </span>
                  <span class="text-sm text-gray-900">{entry.title}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-center">
          <a href="/updates" class="text-sm text-blue-600 underline hover:text-blue-800">更新情報をすべて見る</a>
        </p>
      </div>
    )}

    <p class="mt-12 text-center text-sm text-gray-500">
      公式情報は
      <a
        href="https://www.city.kiryu.lg.jp/shigikai/index.html"
        class="text-blue-600 underline hover:text-blue-800"
        target="_blank"
        rel="noopener noreferrer"
      >
        桐生市議会公式サイト
      </a>
      をご覧ください。
    </p>
  </section>
</Layout>
